---
// "Show, don't tell": what you can just do on Din, as one fast loop.
//
// 1. Change everything: real footage of Din trying on themes from its App
//    Store; then the assistant makes a theme from a sentence (power
//    mode kicks in partway through typing it), and the desktop, its windows
//    and its icons turn into an old-growth forest.
// 2. Share it: the theme and icons go to friends, whose desktops change too.
// 3. Make an app: the assistant makes RangerStar, then more apps.
// 4. Send it anywhere: to a friend on Din, and to friends' phones, where it
//    opens in the browser, because Din apps are websites.
//
// It's drawn, not recorded: Din's chrome and real apps' screens, staged. The
// forest is MK Fain's Old Growth theme (wallpaper and colors from its theme
// event); the apps are real ones on Din's App Store (MK's RangerStar, Team
// Soapbox's Birdstar, Chad's Espy).
//
// Everything is laid out in cqw (hundredths of the stage's width), so the
// whole thing scales as one picture.
const themePrompt = "Make my desktop an old-growth forest: moss, ferns, morning fog. Icons too.";
const prompt = "Make me a nature course for where I live, with a grumpy bird who quizzes me.";

// Lucide icons, the set Din's chrome uses (WindowHeader's controls, the
// assistant prompt, the menu bar's indicators).
const lucide: Record<string, string> = {
  minus: '<path d="M5 12h14"/>',
  maximize: '<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  paperclip: '<path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
  up: '<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  grid: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  battery: '<rect width="16" height="10" x="2" y="7" rx="2" ry="2"/><line x1="22" x2="22" y1="11" y2="13"/><line x1="6" x2="6" y1="11" y2="13"/><line x1="10" x2="10" y1="11" y2="13"/>',
  bluetooth: '<path d="m7 7 10 10-5 5V2l5 5L7 17"/>',
  wifi: '<path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/>',
  user: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/>',
};
const icon = (name: string) =>
  `<svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${lucide[name]}</svg>`;
const controls = `<span class="controls">${icon("minus")}${icon("maximize")}${icon("x")}</span>`;

// Each app's title bar takes its page's theme-color, as Din's windows do.
const apps = {
  ranger: { name: "RangerStar", tb: "#f8f6f2", fg: "#1f2a22" },
  birdstar: { name: "Birdstar", tb: "#05070f", fg: "#e7e9f2" },
  espy: { name: "Espy", tb: "#faf6f0", fg: "#4a3a30" },
};

const people = [
  { name: "Alex", avatar: "/reel/avatar-alex.webp", wall: "/reel/friend-kawaii-dreams.jpg" },
  { name: "MK", avatar: "/reel/avatar-mk.webp", wall: "/reel/friend-rubiks.jpg" },
  { name: "Chad", avatar: "/reel/avatar-chad.webp", wall: "/reel/friend-warm-cottage.jpg" },
];

const dockApps = ["file-browser", "settings", "web-browser", "app-store", "assistant"];

---

<div class="reel" data-reel data-step="theme" data-beat="browse" data-theme-prompt={themePrompt}>
  <div class="stage">
    <img class="desk" src="/reel/desk-default.webp" alt="" />
    <img class="desk forest" src="/reel/og-bg.webp" alt="" />
    <div class="bar" aria-hidden="true">
      <span class="bar-l"><Fragment set:html={icon("grid")} /> Apps</span>
      <span>Thu Oct 29&nbsp;&nbsp;4:38 PM</span>
      <span class="bar-r"><Fragment set:html={["bot", "sun", "battery", "bluetooth", "wifi", "user"].map(icon).join("")} /></span>
    </div>
    <div class="dock" aria-hidden="true">
      {
        dockApps.map((n, i) => (
          <span class="slot" style={`--i: ${i}`}>
            <img class="d" src={`/reel/dock-${n}.webp`} alt="" />
            <img class="f" src={`/reel/forest-${n}.webp`} alt="" />
          </span>
        ))
      }
    </div>

    <video
      class="footage"
      src="/reel/reel.mp4"
      poster="/reel/reel-poster.jpg"
      muted
      playsinline
      preload="auto"
      aria-label="Din trying on themes from its App Store, one after another"
    ></video>

    <div class="scene" aria-hidden="true">
      <!-- The prompt, for the theme and then the app -->
      <div class="ask" data-ask>
        <div class="ask-head"><img class="ask-bot" src="/reel/dock-assistant.webp" alt="" /> Ask the assistant</div>
        <div class="ask-text"><span data-typed></span><span class="caret" data-caret></span></div>
        <div class="ask-foot">
          <Fragment set:html={icon("paperclip")} />
          <span class="model"><span class="claude"></span>Claude Sonnet 5.5<Fragment set:html={icon("chevron")} /></span>
          <span class="grow"></span>
          <Fragment set:html={icon("mic")} />
          <span class="send"><Fragment set:html={icon("up")} /></span>
        </div>
        <div class="ask-hint">↵ to send · Esc to close · Super+A anytime, hold it to speak</div>
      </div>

      <!-- 1. The theme being made -->
      <div class="making"><span class="spin"></span>Making your theme</div>

      <!-- 2. Sharing it -->
      <div class="win themecard">
        <div class="tc-preview">
          <img src="/reel/og-bg.webp" alt="" />
          <span class="tc-icons">{dockApps.map((n) => <img src={`/reel/forest-${n}.webp`} alt="" />)}</span>
        </div>
        <div class="tc-row">
          <span><b>Old Growth</b><small>Theme and icons</small></span>
          <span class="tc-btn"><span class="t1">Share</span><span class="t2">Shared ✓</span></span>
        </div>
      </div>

      <div class="grid3 tfriends">
        {
          people.map((p, i) => (
            <figure class:list={["friend", `f${i}`]}>
              <div class="mini">
                <img class="mw" src={p.wall} alt="" />
                <img class="mw forest" src="/reel/og-bg.webp" alt="" />
                <div class="toast">
                  <img src="/reel/forest-assistant.webp" alt="" />
                  <span><b>Old Growth</b><small>Theme and icons · Try it</small></span>
                </div>
                <span class="mdock">
                  {dockApps.map((n, j) => (
                    <span class="slot" style={`--i: ${j}`}>
                      <img class="d" src={`/reel/dock-${n}.webp`} alt="" />
                      <img class="f" src={`/reel/forest-${n}.webp`} alt="" />
                    </span>
                  ))}
                </span>
              </div>
              <figcaption><img src={p.avatar} alt="" />{p.name}'s computer</figcaption>
            </figure>
          ))
        }
      </div>

      <!-- 3. The assistant making an app -->
      <div class="win assistant">
        <div class="titlebar"><img src="/reel/forest-assistant.webp" alt="" /><span>Assistant</span><Fragment set:html={controls} /></div>
        <div class="as-main">
          <div class="as-bubble">{prompt}</div>
          <p class="as-line">On it.</p>
          <div class="as-card">
            <div class="as-preview"><img src="/reel/ranger-home.webp" alt="" /><span class="shimmer"></span></div>
            <div class="as-status">
              <img src="/reel/icon-ranger.webp" alt="" />
              <span class="as-name"><b>RangerStar</b><span class="s1">Making it…</span><span class="s2">Ready</span></span>
              <span class="as-open">Open</span>
            </div>
            <div class="as-bar"><span></span></div>
          </div>
          <div class="as-compose">Ask for anything</div>
        </div>
      </div>

      <div class="win app ranger" style={`--tb: ${apps.ranger.tb}; --tbfg: ${apps.ranger.fg}`}>
        <div class="titlebar"><img src="/reel/icon-ranger.webp" alt="" /><span>RangerStar</span><Fragment set:html={controls} /></div>
        <div class="app-view">
          <img class="r-home" src="/reel/ranger-home.webp" alt="" />
          <img class="r-region" src="/reel/ranger-region.webp" alt="" />
        </div>
      </div>
      <div class="win app birdstar" style={`--tb: ${apps.birdstar.tb}; --tbfg: ${apps.birdstar.fg}`}>
        <div class="titlebar"><img src="/reel/icon-birdstar.webp" alt="" /><span>Birdstar</span><Fragment set:html={controls} /></div>
        <div class="app-view"><img src="/reel/birdstar-stars.webp" alt="" /></div>
      </div>
      <div class="win app espy" style={`--tb: ${apps.espy.tb}; --tbfg: ${apps.espy.fg}`}>
        <div class="titlebar"><img src="/reel/icon-espy.webp" alt="" /><span>Espy</span><Fragment set:html={controls} /></div>
        <div class="app-view"><img src="/reel/espy.webp" alt="" /></div>
      </div>

      <!-- 4. Sending it anywhere -->
      <div class="win dialog share">
        <div class="titlebar"><span>Send RangerStar to…</span><Fragment set:html={controls} /></div>
        <div class="people">
          {
            people.map((p, i) => (
              <div class:list={["person", `p${i}`]}>
                <span class="avatar"><img src={p.avatar} alt="" /></span>
                <span>{p.name}</span>
              </div>
            ))
          }
        </div>
        <button class="send-btn" tabindex="-1">Send</button>
      </div>

      <div class="devices">
        <figure class="dev d0">
          <div class="mini">
            <img class="mw" src="/reel/og-bg.webp" alt="" />
            <div class="toast">
              <img src="/reel/icon-ranger.webp" alt="" />
              <span><b>RangerStar</b><small>Sent to you just now</small></span>
            </div>
            <div class="mini-win" style={`--tb: ${apps.ranger.tb}; --tbfg: ${apps.ranger.fg}`}>
              <div class="titlebar"><img src="/reel/icon-ranger.webp" alt="" /><span>RangerStar</span><Fragment set:html={controls} /></div>
              <img src="/reel/ranger-region.webp" alt="" />
            </div>
          </div>
          <figcaption><img src={people[0].avatar} alt="" />Alex's Din</figcaption>
        </figure>
        <figure class="dev d1">
          <div class="phone iphone">
            <span class="island"></span>
            <div class="screen">
              <div class="pstatus"><span>9:41</span><span>▮▮▮ ᯤ ▭</span></div>
              <img class="page" src="/reel/ranger-mobile.webp" alt="" />
              <div class="url bottom">nsite.lol</div>
              <div class="banner"><img src="/reel/icon-ranger.webp" alt="" /><span><b>RangerStar</b><small>Sent to you just now</small></span></div>
            </div>
          </div>
          <figcaption><img src={people[1].avatar} alt="" />MK's iPhone</figcaption>
        </figure>
        <figure class="dev d2">
          <div class="phone android">
            <span class="hole"></span>
            <div class="screen">
              <div class="pstatus"><span>9:41</span><span>ᯤ ▮</span></div>
              <div class="url top">…ranger-star.nsite.lol</div>
              <img class="page" src="/reel/ranger-mobile.webp" alt="" />
              <div class="banner"><img src="/reel/icon-ranger.webp" alt="" /><span><b>RangerStar</b><small>Sent to you just now</small></span></div>
            </div>
          </div>
          <figcaption><img src={people[2].avatar} alt="" />Chad's Android</figcaption>
        </figure>
      </div>

      <svg class="cursor" data-cursor viewBox="0 0 24 24"><path d="M4 2l15 11-7 1-3 7z" /></svg>
    </div>

    <canvas class="sparks" data-sparks></canvas>
  </div>

</div>

<style>
  .reel {
    width: 100%;
    text-align: left;
  }

  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: clamp(16px, 3vw, 44px);
    overflow: hidden;
    background: #14081f;
    box-shadow: 0 40px 80px -40px rgb(34 18 51 / 0.7), 0 0 0 1px rgb(34 18 51 / 0.08);
    container-type: inline-size;
    font-family: var(--body);
    /* Din's default look */
    --bg: #070b17;
    --panel: #0e1424;
    --fg: #e6e4ee;
    --primary: #7c3aed;
    --bubble: #222838;
  }

  /* Old Growth, by MK Fain, once the theme is made */
  .reel[data-themed] .stage {
    --bg: #0f1a0f;
    --panel: #162616;
    --fg: #c8d6b0;
    --primary: #b8860b;
    --bubble: #24361f;
  }

  .desk.forest {
    clip-path: circle(0% at 50% 45%);
  }

  .reel[data-themed] .desk.forest {
    clip-path: circle(120% at 50% 45%);
    transition: clip-path 1.5s cubic-bezier(.6, 0, .3, 1);
  }

  .slot {
    display: grid;
  }

  .slot img {
    grid-area: 1 / 1;
  }

  .slot .f {
    opacity: 0;
    scale: 0.3;
  }

  .reel[data-themed] .dock .slot .f {
    opacity: 1;
    scale: 1;
    transition: opacity 0.25s, scale 0.45s cubic-bezier(.2, .9, .3, 1.6);
    transition-delay: calc(0.9s + var(--i) * 0.13s);
  }

  .reel[data-themed] .dock .slot .d {
    opacity: 0;
    scale: 0.3;
    transition: opacity 0.2s, scale 0.25s;
    transition-delay: calc(0.85s + var(--i) * 0.13s);
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    justify-content: space-between;
    padding: 0.45cqw 3.2cqw;
    background: rgb(10 18 10 / 0.55);
    backdrop-filter: blur(8px);
    color: rgb(255 255 255 / 0.85);
    font-size: 0.85cqw;
    font-weight: 600;
  }

  .bar-l,
  .bar-r {
    display: flex;
    align-items: center;
    gap: 0.45cqw;
  }

  .bar-r {
    gap: 0.9cqw;
  }

  .bar :global(.lc) {
    width: 0.95cqw;
    height: 0.95cqw;
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: 1cqw;
    translate: -50% 0;
    display: flex;
    gap: 1cqw;
  }

  .dock img {
    width: 3.4cqw;
    height: 3.4cqw;
    filter: drop-shadow(0 0.3cqw 0.4cqw rgb(0 0 0 / 0.4));
  }

  .desk,
  .scene,
  .sparks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .desk,
  .footage {
    object-fit: cover;
  }

  .footage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  .reel[data-beat="browse"] .footage {
    visibility: visible;
  }

  /* The drawn menu bar sits over the footage's own, which the stage's
     round corners would clip. */
  .bar {
    z-index: 2;
  }

  .reel[data-beat="browse"] .bar {
    background: rgb(8 8 12 / 0.92);
  }

  .scene,
  .sparks {
    pointer-events: none;
  }

  .scene > * {
    position: absolute;
    visibility: hidden;
  }

  /* ---------- Din's window chrome ---------- */

  .win {
    background: var(--bg);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1cqw;
    box-shadow: 0 2cqw 5cqw rgb(0 0 0 / 0.55);
    color: var(--fg);
    font-size: 1.1cqw;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .titlebar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.55cqw;
    height: 2.3cqw;
    padding: 0 0.6cqw 0 0.8cqw;
    background: var(--tb, var(--bg));
    border-bottom: 1px solid color-mix(in srgb, var(--tbfg, #fff) 8%, transparent);
    font-weight: 500;
    font-size: 0.92cqw;
    color: var(--tbfg, var(--fg));
  }

  .stage :global(.lc) {
    width: 1.25cqw;
    height: 1.25cqw;
    flex: none;
  }

  .stage :global(.controls) {
    display: flex;
    gap: 0.35cqw;
    opacity: 0.6;
  }

  .stage :global(.controls .lc) {
    width: 1.5cqw;
    height: 1.5cqw;
    padding: 0.3cqw;
  }

  .stage :global(.controls .lc:nth-child(2)) {
    padding: 0.38cqw;
  }

  .titlebar > span:not(.x) {
    flex: 1;
  }

  .titlebar img {
    width: 1.3cqw;
    height: 1.3cqw;
    border-radius: 0.3cqw;
  }

  .spin {
    display: inline-block;
    width: 0.9cqw;
    height: 0.9cqw;
    border: 0.15cqw solid rgb(255 255 255 / 0.25);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: -0.1cqw;
  }

  .cursor {
    width: 2cqw;
    height: 2cqw;
    fill: #fff;
    stroke: #111;
    stroke-width: 1.4;
    filter: drop-shadow(0 0.2cqw 0.3cqw rgb(0 0 0 / 0.5));
    left: 0;
    top: 0;
    z-index: 20;
  }

  /* ---------- 2a. The prompt ---------- */

  .ask {
    left: 22%;
    top: 28%;
    width: 56%;
    padding: 1.1cqw 1.3cqw 0.9cqw;
    border-radius: 1.3cqw;
    background: var(--bg);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 2cqw 6cqw rgb(0 0 0 / 0.6);
    color: #fff;
  }

  .ask-head {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    color: rgb(255 255 255 / 0.7);
    font-size: 1.1cqw;
    margin-bottom: 1cqw;
  }

  .ask-head img {
    width: 1.8cqw;
    height: 1.8cqw;
  }

  .ask-text {
    min-height: 4.4cqw;
    font-size: 1.5cqw;
    line-height: 1.5;
  }

  .caret {
    display: inline-block;
    width: 0.1cqw;
    height: 1.7cqw;
    margin-left: 0.05cqw;
    background: #fff;
    vertical-align: -0.25cqw;
    animation: blink 1s steps(1) infinite;
  }

  .ask-foot {
    display: flex;
    align-items: center;
    gap: 1.1cqw;
    margin-top: 0.6cqw;
    color: rgb(255 255 255 / 0.6);
    font-size: 1cqw;
  }

  .model {
    display: flex;
    align-items: center;
    gap: 0.45cqw;
  }

  .model :global(.lc) {
    width: 0.8cqw;
    height: 0.8cqw;
  }

  .claude {
    width: 1cqw;
    height: 1cqw;
    border-radius: 50%;
    border: 0.12cqw solid #8f7cff;
  }

  .grow {
    flex: 1;
  }

  .send {
    display: grid;
    place-items: center;
    width: 2.1cqw;
    height: 2.1cqw;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--bg);
  }

  .send :global(.lc) {
    width: 1.1cqw;
    height: 1.1cqw;
  }

  .ask-hint {
    margin-top: 0.8cqw;
    text-align: right;
    font-size: 0.85cqw;
    color: rgb(255 255 255 / 0.5);
  }

  .reel[data-beat="tprompt"] .ask,
  .reel[data-beat="prompt"] .ask {
    visibility: visible;
    animation: pop-in 0.35s 0.15s cubic-bezier(.2, .9, .3, 1.3) both;
  }

  .reel[data-beat="tprompt"] .send,
  .reel[data-beat="prompt"] .send {
    animation: press 0.25s 3.5s both;
  }

  /* ---------- 2b. The assistant making it ---------- */

  .assistant {
    left: 22%;
    top: 7%;
    width: 56%;
    height: 80%;
  }

  .as-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    padding: 1.8cqw 2.2cqw 1.6cqw;
    min-height: 0;
  }

  .as-bubble {
    align-self: flex-end;
    max-width: 78%;
    padding: 0.8cqw 1.2cqw;
    border-radius: 1.3cqw;
    background: var(--bubble);
    font-size: 1.15cqw;
    line-height: 1.45;
  }

  .as-line {
    margin: 0;
    font-size: 1.2cqw;
    opacity: 0;
  }

  .as-card {
    width: 62%;
    border-radius: 1.2cqw;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid rgb(255 255 255 / 0.08);
    opacity: 0;
  }

  .as-preview {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #1c2a1c;
  }

  .as-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
