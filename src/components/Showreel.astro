    const stage = root.querySelector<HTMLElement>(".stage")!;
    const ask = root.querySelector<HTMLElement>("[data-ask]")!;
    const video = root.querySelector<HTMLVideoElement>(".footage")!;
    const typedEl = root.querySelector<HTMLElement>("[data-typed]")!;
    const caret = root.querySelector<HTMLElement>("[data-caret]")!;
    const cursor = root.querySelector<SVGElement>("[data-cursor]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-sparks]")!;
    const ctx = canvas.getContext("2d")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const PROMPTS: Record<string, string> = {
      tprompt: root.dataset.themePrompt!,
      prompt: root.querySelector<HTMLElement>(".as-bubble")!.textContent!.trim(),
    };

    // The loop, in seconds. Each beat is [name, step, start].
    const BEATS = [
      ["browse", "theme", 0],
      ["tprompt", "theme", 2.2],
      ["tmake", "theme", 6.1],
      ["tshare", "share", 9.6],
      ["tarrive", "share", 11.8],
      ["prompt", "build", 15.0],
      ["work", "build", 19.2],
      ["result", "build", 22.4],
      ["more", "build", 25.0],
      ["pick", "send", 27.0],
      ["devices", "send", 29.5],
    ] as const;
    const LOOP = 33.6;
    // The forest takes over a moment after the theme is asked for.
    const THEMED_AT = 7.1;
    // Typing starts this long into a prompt beat, and takes this long.
    const TYPE_FROM = 0.6;
    const TYPE_FOR = 2.6;
    const SPARKS_FROM = 30;

    // The pretend cursor's path, per beat: [seconds into the beat, x%, y%].
    const PATHS: Record<string, [number, number, number][]> = {
      work: [[0, 75, 90], [1.9, 75, 90], [2.7, 54, 72], [3.2, 54, 72]],
      tshare: [[0, 60, 85], [0.4, 60, 85], [1.2, 87.5, 51.5], [2.2, 87.5, 51.5]],
      pick: [[0, 30, 80], [0.5, 40, 47], [0.9, 40, 47], [1.15, 50.5, 47], [1.5, 61, 47], [1.95, 53, 61], [2.5, 53, 61]],
    };

    let t = 0;
    let last = 0;
    let raf = 0;
    let beat = "";
    let typedCount = 0;

    type Spark = { x: number; y: number; vx: number; vy: number; life: number; age: number; size: number };
    let sparks: Spark[] = [];

    const sizeCanvas = () => {
      const r = stage.getBoundingClientRect();
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    sizeCanvas();
    addEventListener("resize", sizeCanvas);

    // Din's power mode sparks (src/lib/powerMode.ts and cursorEffects'
    // sparks()): a spray of dots in the text's color from the caret, thrown
    // up and falling as they fade; and a little knock to the window.
    const throwSparks = () => {
      const s = stage.getBoundingClientRect();
      const c = caret.getBoundingClientRect();
      const k = s.width / 1280;
      const n = 5 + Math.floor(Math.random() * 11);
      for (let i = 0; i < n; i++) {
        sparks.push({
          x: c.left - s.left,
          y: c.top - s.top + c.height / 2,
          vx: (Math.random() * 2 - 1) * 60 * k,
          vy: (-90 - Math.random() * 120) * k,
          life: 0.7 + Math.random() * 0.5,
          age: 0,
          size: (3 + Math.random() * 3) * k,
        });
      }
      const a = Math.random() * Math.PI * 2;
      const d = (1 + Math.random() * 2) * k;
      ask.animate([{ translate: `${Math.cos(a) * d}px ${Math.sin(a) * d}px` }, { translate: "0 0" }], { duration: 120, easing: "ease-out" });
    };

    const drawSparks = (dt: number) => {
      const r = stage.getBoundingClientRect();
      ctx.clearRect(0, 0, r.width, r.height);
      const k = r.width / 1280;
      sparks = sparks.filter((p) => (p.age += dt) < p.life);
      for (const p of sparks) {
        p.vy += 270 * k * dt;
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        ctx.globalAlpha = 1 - p.age / p.life;
        ctx.fillStyle = "#fff";
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const setBeat = (name: string, step: string) => {
      if (beat === name) return;
      beat = name;
      // Clear and re-set, so CSS animations start again from the top.
      root.dataset.beat = "";
      root.dataset.step = "";
      void root.offsetWidth;
      root.dataset.beat = name;
      root.dataset.step = step;
      if (name === "browse") {
        video.currentTime = 0;
        video.play().catch(() => {});
      }
      if (name === "prompt" || name === "tprompt") {
        typedCount = 0;
        typedEl.textContent = "";
      }
    };

    const moveCursor = (name: string, e: number) => {
      const path = PATHS[name];
      if (!path) {
        delete root.dataset.cursorOn;
        return;
      }
      root.dataset.cursorOn = "";
      let i = 0;
      while (i < path.length - 2 && e > path[i + 1][0]) i++;
      const [t0, x0, y0] = path[i];
      const [t1, x1, y1] = path[i + 1];
      const f = Math.min(1, Math.max(0, (e - t0) / (t1 - t0 || 1)));
      const ease = f < 0.5 ? 2 * f * f : 1 - (-2 * f + 2) ** 2 / 2;
      cursor.style.left = `${x0 + (x1 - x0) * ease}%`;
      cursor.style.top = `${y0 + (y1 - y0) * ease}%`;
    };

    const render = (dt: number) => {
      let cur: (typeof BEATS)[number] = BEATS[0];
      for (const b of BEATS) if (t >= b[2]) cur = b;
      const [name, step, start] = cur;
      setBeat(name, step);
      const e = t - start;

      if (name === "prompt" || name === "tprompt") {
        const text = PROMPTS[name];
        const want = Math.max(0, Math.min(text.length, Math.floor(((e - TYPE_FROM) / TYPE_FOR) * text.length)));
        while (typedCount < want) {
          typedCount++;
          typedEl.textContent = text.slice(0, typedCount);
          if (typedCount >= SPARKS_FROM && typedCount % 2 === 0) throwSparks();
        }
      }
      if (t >= THEMED_AT) root.dataset.themed = "";
      else delete root.dataset.themed;
      moveCursor(name, e);
      drawSparks(dt);

    };

    const tick = (now: number) => {
      raf = requestAnimationFrame(tick);
      const dt = Math.min(0.1, (now - (last || now)) / 1000);
      last = now;
      t += dt;
      if (t >= LOOP) {
        t = 0;
        beat = "";
      }
      render(dt);
    };

    const run = () => {
      if (raf) return;
      last = 0;
      raf = requestAnimationFrame(tick);
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      video.pause();
    };

    if (!reduce) {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? run() : stop()), { threshold: 0.35 }).observe(root);
    }
  }
</script>
