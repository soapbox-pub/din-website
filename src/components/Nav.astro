---
import logo from "../assets/din-logo.svg";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={["nav", { overlay }]} data-nav>
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="Din, home">
      <img src={logo.src} alt="" width="74" height="51" />
    </a>
    <div class="actions">
      <a class="btn small gold" href="/download/">Download</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const update = () => nav.classList.toggle("scrolled", window.scrollY > 24);
    update();
    addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--ink);
    background: rgb(255 247 234 / 0.82);
    backdrop-filter: blur(14px) saturate(1.4);
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }

  .nav.scrolled {
    box-shadow: 0 1px 0 rgb(34 18 51 / 0.08), 0 10px 30px -20px rgb(34 18 51 / 0.4);
  }

  .nav.overlay {
    position: fixed;
    inset: 0 0 auto;
    color: #fff;
    background: linear-gradient(180deg, rgb(18 6 31 / 0.55), transparent);
    backdrop-filter: none;
  }

  .nav.overlay.scrolled {
    color: #fff;
    background: rgb(29 11 51 / 0.86);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    width: min(1320px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    height: 76px;
  }

  .brand img {
    height: 44px;
    width: auto;
    filter: drop-shadow(0 0 10px rgb(255 181 71 / 0.35));
    transition: transform 0.3s, filter 0.3s;
  }

  .brand:hover img {
    transform: rotate(-4deg) scale(1.06);
    filter: drop-shadow(0 0 18px rgb(255 181 71 / 0.7));
  }

  .nav:not(.overlay) .brand img {
    filter: drop-shadow(0 1px 0 rgb(120 60 0 / 0.5)) drop-shadow(0 0 8px rgb(255 181 71 / 0.4));
  }

  .actions {
    display: flex;
    gap: 10px;
    margin-left: auto;
  }
</style>
